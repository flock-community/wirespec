{
  "asyncapi": "2.6.0",
  "id": "urn:example:streetlights",
  "info": {
    "title": "Streetlights API",
    "version": "1.0.0",
    "license": { "name": "Apache 2.0" }
  },
  "servers": {
    "production": {
      "url": "broker.example.com:{port}",
      "protocol": "mqtt",
      "variables": { "port": { "default": "1883", "enum": ["1883", "8883"] } }
    }
  },
  "defaultContentType": "application/json",
  "tags": [{ "name": "lights" }],
  "externalDocs": { "url": "https://example.com" },
  "channels": {
    "streetlights/{streetlightId}/lighting/measured": {
      "description": "The topic on which measured values may be produced and consumed.",
      "parameters": {
        "streetlightId": { "description": "The ID of the streetlight.", "schema": { "type": "string" } }
      },
      "subscribe": {
        "operationId": "receiveLightMeasurement",
        "summary": "Receive information about environmental lighting conditions",
        "traits": [{ "$ref": "#/components/operationTraits/kafka" }],
        "message": { "$ref": "#/components/messages/lightMeasured" }
      }
    },
    "streetlights/{streetlightId}/turn": {
      "parameters": { "streetlightId": { "$ref": "#/components/parameters/streetlightId" } },
      "publish": {
        "operationId": "turnOnOff",
        "message": { "oneOf": [{ "$ref": "#/components/messages/turnOn" }, { "$ref": "#/components/messages/turnOff" }] }
      },
      "subscribe": { "message": { "$ref": "#/components/messages/turnOn" } }
    },
    "streetlights/{streetlightId}/dim": {
      "publish": {
        "message": {
          "name": "dimLight",
          "schemaFormat": "application/vnd.aai.asyncapi;version=2.6.0",
          "payload": {
            "type": "object",
            "properties": {
              "percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
              "sentAt": { "$ref": "#/components/schemas/sentAt" }
            }
          }
        }
      }
    },
    "streetlights/avro": {
      "subscribe": {
        "message": {
          "schemaFormat": "application/vnd.apache.avro;version=1.9.0",
          "payload": { "type": "record", "name": "Reading", "fields": [{ "name": "lumens", "type": "int" }] }
        }
      }
    },
    "empty": {}
  },
  "components": {
    "messages": {
      "lightMeasured": {
        "name": "lightMeasured",
        "title": "Light measured",
        "contentType": "application/json",
        "traits": [{ "$ref": "#/components/messageTraits/commonHeaders" }],
        "payload": { "$ref": "#/components/schemas/lightMeasuredPayload" }
      },
      "turnOn": { "name": "turnOn", "payload": { "$ref": "#/components/schemas/turnOnOffPayload" } },
      "turnOff": { "name": "turnOff", "payload": { "$ref": "#/components/schemas/turnOffPayload" } }
    },
    "schemas": {
      "lightMeasuredPayload": {
        "type": "object",
        "properties": {
          "lumens": { "type": "integer", "minimum": 0, "description": "Light intensity measured in lumens." },
          "sentAt": { "$ref": "#/components/schemas/sentAt" }
        }
      },
      "turnOnOffPayload": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "enum": ["on", "off"], "description": "Whether to turn on or off the light." },
          "sentAt": { "$ref": "#/components/schemas/sentAt" }
        }
      },
      "turnOffPayload": {
        "allOf": [
          { "$ref": "#/components/schemas/turnOnOffPayload" },
          { "type": "object", "properties": { "fadeOut": { "type": "boolean" } } }
        ]
      },
      "sentAt": { "type": "string", "format": "date-time", "description": "Date and time when the message was sent." }
    },
    "parameters": {
      "streetlightId": { "description": "The ID of the streetlight.", "schema": { "type": "string" } }
    },
    "messageTraits": {
      "commonHeaders": {
        "headers": { "type": "object", "properties": { "my-app-header": { "type": "integer", "minimum": 0, "maximum": 100 } } }
      }
    },
    "operationTraits": { "kafka": { "bindings": { "kafka": { "clientId": "my-app-id" } } } }
  }
}
